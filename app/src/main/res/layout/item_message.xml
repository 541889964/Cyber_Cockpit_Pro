<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">

    <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tvContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="14dp" android:textSize="15sp" android:textColor="#E2E8F0" android:lineSpacingExtra="6dp"/>
</LinearLayout>
